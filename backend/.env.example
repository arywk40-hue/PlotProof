# Required for VERIFIED submissions to be pinned to IPFS.
PINATA_JWT=replace_with_a_Pinata_JWT
# Optional: absolute path is recommended in a hosted environment.
PLOTPROOF_DB_PATH=data/plotproof.sqlite
PORT=4000
# Exact browser origin (no trailing slash). For Vercel, use your deployed URL.
# Use http://127.0.0.1:5173 instead if that is how you open local Vite.
FRONTEND_ORIGIN=http://localhost:5173
# Node 22.5 requires this flag for node:sqlite.
NODE_OPTIONS=--experimental-sqlite
